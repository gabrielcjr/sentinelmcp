# SentinelMCP Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Free-Tier LLM Provider Settings (Optional for offline/fallback mode)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Kubernetes / Cluster Configuration
K8S_IN_CLUSTER=false
K8S_NAMESPACE=default
K8S_CONTEXT=

# SigNoz Observability Endpoint
SIGNOZ_API_URL=http://localhost:8080
SIGNOZ_API_KEY=

# Safety & Blast-Radius Guardrails
SENTINEL_DRY_RUN=true
MAX_RESTARTS_PER_HOUR=3
MAX_REPLICAS_LIMIT=10
MIN_REPLICAS_LIMIT=1
REMEDIATION_COOLDOWN_SECONDS=120

# MCP Server Settings
MCP_SERVER_NAME=sentinel-mcp-sre
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
